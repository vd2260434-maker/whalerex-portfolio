# Whalerex Portfolio & Admin Environment Variables
# Copy these to your Vercel Project Settings > Environment Variables

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password

# JWT Session Secret (Random 32+ character string)
JWT_SECRET=your_random_secret

# Optional: Notification email for contact inquiries
ADMIN_NOTIFICATION_EMAIL=your_email@example.com
